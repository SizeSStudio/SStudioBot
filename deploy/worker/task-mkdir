#!/bin/bash
# Create a worker task dir owned by the worker user (group of the same name, so the core can read it).
# Called by the core only as:  sudo -n /usr/local/lib/sbot/task-mkdir [--host] <task-id>
set -euo pipefail
user=sbot-w
if [ "${1:-}" = --host ]; then user=sbot-h; shift; fi
id="${1:-}"
[[ "$id" =~ ^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$ ]] || { echo "task-mkdir: bad id" >&2; exit 64; }
install -d -o $user -g $user -m 2770 "/srv/data/$user/tasks/$id"
echo "/srv/data/$user/tasks/$id"
