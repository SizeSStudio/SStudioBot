<?xml version="1.0" encoding="UTF-8"?>
<!-- sbot-node on a Mac (docs/tech/05): a per-user LaunchAgent. install.sh fills in the @...@ fields and puts it in
     ~/Library/LaunchAgents; nothing installs it automatically. KeepAlive starts it again after exit 75 (upgrade). -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>local.sbot-node</string>
  <key>ProgramArguments</key>
  <array>
    <string>@NODE@</string>
    <string>@ROOT@/current/node/src/cli.ts</string>
    <string>run</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>SBOT_NODE_ROOT</key><string>@ROOT@</string>
    <!-- so the node finds claude, codex, pi and gh the way my shell does -->
    <key>PATH</key><string>@PATH@</string>
  </dict>
  <key>WorkingDirectory</key><string>@HOME@</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>2</integer>
  <key>ExitTimeOut</key><integer>30</integer>
  <key>ProcessType</key><string>Interactive</string>
  <key>StandardOutPath</key><string>@HOME@/Library/Logs/sbot-node.log</string>
  <key>StandardErrorPath</key><string>@HOME@/Library/Logs/sbot-node.log</string>
</dict>
</plist>
